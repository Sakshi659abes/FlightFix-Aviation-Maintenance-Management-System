# FlightFix Environment Configuration
# Supabase PostgreSQL Database Settings
# Replace with your Supabase direct/pooled connection string:
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase API Credentials (Optional for client-side direct interactions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Django Security Settings
DEBUG=True
SECRET_KEY=flightfix-aerospace-secret-key-mro-prod-grade-9e305d24
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
